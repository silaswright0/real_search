# Copy to .env and populate every required secret before startup.
SEARXNG_SECRET=
YACY_ADMIN_USER=
YACY_ADMIN_PASSWORD=
YACY_RESOURCE=local
QDRANT_API_KEY=
# Generate at least 32 random bytes; never expose this to browser JS.
CLICK_BROKER_TOKEN=
# Valkey requirepass; use hex or url-safe characters only (no @ : /).
VALKEY_PASSWORD=
# GID of the group that owns /var/run/docker.sock on the Docker host.
# WSL/Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=
# HTTPS is mandatory unless this is explicitly changed to 1.
ALLOW_INSECURE_HTTP=0
