# Copy to .env and populate every required secret before startup.
SEARXNG_SECRET=
YACY_ADMIN_USER=
YACY_ADMIN_PASSWORD=
YACY_RESOURCE=local
QDRANT_API_KEY=
# Generate at least 32 random bytes; never expose this to browser JS.
CLICK_BROKER_TOKEN=
# Docker Desktop compatibility default. Use runsc on a supported Linux host.
SANDBOX_RUNTIME=runc
# HTTPS is mandatory unless this is explicitly changed to 1.
ALLOW_INSECURE_HTTP=0
