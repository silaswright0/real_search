# Tor itself only listens on loopback. Public SOCKS endpoints are the
# auth gate, which rejects unauthenticated clients and forwards credentials
# so IsolateSOCKSAuth can create distinct circuits.
SocksPort 127.0.0.1:9051 IsolateSOCKSAuth KeepAliveIsolateSOCKSAuth
SocksPolicy accept 127.0.0.1
SocksPolicy reject *
DataDirectory /var/lib/tor
PidFile /var/lib/tor/tor.pid
Log notice stdout
RunAsDaemon 0
ClientOnly 1
# Docker already applies seccomp. Tor's extra sandbox aborts under
# cap_drop/WSL with no SOCKS listener.
Sandbox 0
ClientUseIPv6 0
